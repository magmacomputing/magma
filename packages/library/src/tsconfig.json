{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist",
    "rootDir": ".",
    "composite": true,
    "lib": [
      "ESNext",
      "ESNext.Temporal",
      "DOM"
    ],
    "types": [
      "node",
      "hammerjs",
      "jquery",
      "google.maps"
    ],
    "paths": {
      "#library": [
        "./common.index.ts"
      ],
      "#library/primitives/*.js": ["./common/primitives/*.ts"],
      "#library/temporal/*.js": ["./common/temporal/*.ts"],
      "#library/security/*.js": ["./common/security/*.ts"],
      "#library/scheduling/*.js": ["./common/scheduling/*.ts"],
      "#library/runtime/*.js": ["./common/runtime/*.ts"],
      "#library/*.js": [
        "./common/primitives/*.ts",
        "./common/temporal/*.ts",
        "./common/security/*.ts",
        "./common/runtime/*.ts",
        "./common/scheduling/*.ts"
      ],
      "#library/*": [
        "./common/primitives/*",
        "./common/temporal/*",
        "./common/security/*",
        "./common/runtime/*",
        "./common/scheduling/*"
      ],
      "#browser/*.js": [
        "./browser/*.ts"
      ],
      "#browser/*": [
        "./browser/*"
      ],
      "#server/*.js": [
        "./server/*.ts"
      ],
      "#server/*": [
        "./server/*"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ]
}