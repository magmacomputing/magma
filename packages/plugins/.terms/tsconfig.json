{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "noEmit": false,
    "paths": {
      "tempo-kit/plugin/sdk": ["../../tempo/src/plugin/plugin.sdk.ts"],
      "tempo-kit": ["../../tempo/src/tempo.index.ts"],
      "tempo-fns": ["../../functions/src/index.ts"],
      "tempo-lib": ["../../library/src/common.index.ts"],
      "#library/*": ["../../library/src/common/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../../library/src" },
    { "path": "../../tempo/src" },
    { "path": "../../functions" }
  ]
}
