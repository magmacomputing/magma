{
  "name": "@magmacomputing/tempo-plugin-astro",
  "version": "2.4.0",
  "description": "Tempo plugin that calculates precise astronomical seasons (solstices & equinoxes) — hemisphere-aware, sub-minute accuracy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    }
  },
  "sideEffects": [
    "./dist/install.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacomputing/magma.git",
    "directory": "packages/plugins/astro"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc",
    "test": "vitest run -c ../vitest.shared.ts",
    "prepublishOnly": "tempo-cli prepublish"
  },
  "peerDependencies": {
    "@magmacomputing/tempo": "^4.4.0"
  },
  "tempo": {
    "vendorVariantId": "tempo-plugin-astro",
    "plan": "community"
  },
  "devDependencies": {},
  "keywords": [
    "tempo",
    "tempo-plugin",
    "magmacomputing",
    "temporal",
    "astronomical-seasons",
    "lunar-phase",
    "lunar-cycle",
    "moon-phase",
    "solstice",
    "equinox",
    "vernal-equinox",
    "autumnal-equinox",
    "summer-solstice",
    "winter-solstice",
    "jean-meeus",
    "hemisphere-aware",
    "season",
    "astronomy",
    "date",
    "datetime",
    "typescript"
  ],
  "type": "module"
}