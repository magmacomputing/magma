{
  "name": "@tempo-kit/plugin-spatial",
  "version": "2.0.0",
  "description": "Tempo community plugin for GIS spatial geometry, Great-Circle navigation, transit velocity, and impossible travel anomaly detection.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacomputing/magma.git",
    "directory": "packages/plugins/spatial"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": [
    "./dist/install.js"
  ],
  "scripts": {
    "build": "tsup && tsc",
    "test": "vitest run -c ../vitest.shared.ts",
    "prepublishOnly": "tempo-cli prepublish"
  },
  "dependencies": {
    "tempo-fns": "^1.2.0"
  },
  "peerDependencies": {
    "tempo-kit": "^5.0.0"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "tempo-kit": "^5.0.0"
  },
  "keywords": [
    "tempo-kit",
    "tempo-kit-plugin",
    "tempo",
    "temporal",
    "tempo-plugin",
    "spatial",
    "gis",
    "haversine",
    "bearing",
    "velocity",
    "impossible-travel",
    "geofencing"
  ],
  "type": "module"
}
