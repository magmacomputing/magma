{
  "name": "@magmacomputing/tempo-plugin-spatial",
  "version": "1.0.0",
  "description": "Tempo community plugin for GIS spatial geometry, Great-Circle navigation, transit velocity, and impossible travel anomaly detection.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacomputing/magma.git",
    "directory": "packages/plugins/spatial"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": [
    "./dist/install.js"
  ],
  "scripts": {
    "build": "tsup && tsc",
    "test": "vitest run -c ../vitest.shared.ts",
    "prepublishOnly": "tempo-cli prepublish"
  },
  "tempo": {
    "vendorVariantId": "tempo-plugin-spatial",
    "plan": "community"
  },
  "dependencies": {
    "@magmacomputing/tempo-fns": "^1.1.0"
  },
  "peerDependencies": {
    "@magmacomputing/tempo": "^4.4.0"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "keywords": [
    "tempo",
    "tempo-plugin",
    "magmacomputing",
    "spatial",
    "gis",
    "haversine",
    "bearing",
    "velocity",
    "impossible-travel",
    "geofencing"
  ],
  "type": "module"
}
