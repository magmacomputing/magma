{
	"name": "@magmacomputing/tempo-plugin-finance",
	"version": "1.0.3",
	"type": "module",
	"description": "Tempo Community Plugin: Finance namespace and fiscal year utilities",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsup && tsc",
		"prepublishOnly": "if [ $(git rev-parse --abbrev-ref HEAD) != main ]; then echo 'ERROR: Must be on main branch to publish.'; exit 1; fi && npm run build",
		"test": "cross-env TEMPO_LICENSE_KEY=\"\" vitest run -c ../vitest.shared.ts"
	},
	"keywords": [
		"tempo",
		"tempo-plugin",
		"magmacomputing",
		"temporal",
		"plugin",
		"finance",
		"fiscal"
	],
	"author": "Magma Computing",
	"license": "MIT",
	"files": [
		"dist",
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"tempo": {
		"vendorVariantId": "tempo-plugin-finance",
		"plan": "community"
	},
	"peerDependencies": {
		"@magmacomputing/tempo": "^3.9.0"
	},
	"devDependencies": {
		"@magmacomputing/tempo": "^3.9.0",
		"vitest": "^4.1.10"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	}
}
