{
	"name": "@magmacomputing/tempo-plugin-finance",
	"version": "1.0.4",
	"type": "module",
	"description": "Tempo Community Plugin: Finance namespace and fiscal year utilities",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsup && tsc",
		"prepublishOnly": "tempo-cli prepublish",
		"test": "vitest run -c ../vitest.shared.ts"
	},
	"keywords": [
		"tempo",
		"tempo-plugin",
		"magmacomputing",
		"temporal",
		"plugin",
		"finance",
		"fiscal"
	],
	"author": "Magma Computing",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/magmacomputing/magma.git",
		"directory": "packages/plugins/finance"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"tempo": {
		"vendorVariantId": "tempo-plugin-finance",
		"plan": "community"
	},
	"peerDependencies": {
		"@magmacomputing/tempo": "^4.0.0"
	},
	"devDependencies": {
		"@magmacomputing/tempo": "^4.0.0",
		"vitest": "^4.1.10"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	}
}