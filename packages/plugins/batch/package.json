{
  "name": "@magmacomputing/tempo-plugin-batch",
  "version": "1.0.2",
  "description": "Tempo community plugin bringing C-level parallelization to massive date arrays via SharedArrayBuffer and Worker Threads.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacomputing/magma.git",
    "directory": "packages/plugins/batch"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc",
    "test": "vitest run -c ../vitest.shared.ts",
    "prepublishOnly": "tempo-cli prepublish"
  },
  "tempo": {
    "vendorVariantId": "tempo-plugin-batch",
    "plan": "community"
  },
  "peerDependencies": {
    "@magmacomputing/tempo": "^4.0.0"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "keywords": [
    "tempo",
    "tempo-plugin",
    "magmacomputing",
    "batch",
    "parallel",
    "threads",
    "worker",
    "performance"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}