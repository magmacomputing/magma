{
  "name": "@tempo-kit/plugin-ticker",
  "version": "3.0.0",
  "description": "Tempo plugin that provides a high-performance continuous execution loop (Ticker) based on temporal mathematics.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    }
  },
  "sideEffects": [
    "./dist/install.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacomputing/magma.git",
    "directory": "packages/plugins/ticker"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc",
    "test": "vitest run -c ../vitest.shared.ts",
    "prepublishOnly": "tempo-cli prepublish"
  },
  "tempo": {
    "vendorVariantId": "tempo-plugin-ticker",
    "plan": "community"
  },
  "peerDependencies": {
    "tempo-kit": "^5.0.0"
  },
  "devDependencies": {
    "tempo-kit": "^5.0.0",
    "@tempo-kit/plugin-ntp": "^2.0.0"
  },
  "keywords": [
    "tempo-kit",
    "tempo-kit-plugin",
    "tempo",
    "temporal",
    "tempo-plugin",
    "ticker",
    "interval",
    "loop",
    "animation",
    "date",
    "datetime",
    "typescript"
  ],
  "type": "module"
}
