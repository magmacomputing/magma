{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "composite": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@magmacomputing/tempo": ["../../tempo/dist/tempo.index.d.ts"],
      "@magmacomputing/tempo/core": ["../../tempo/dist/core.index.d.ts"],
      "@magmacomputing/tempo/*": ["../../tempo/dist/*"],
      "@magmacomputing/library": ["../../library/dist/common.index.d.ts"],
      "#library/*": ["../../library/dist/common/*"]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "references": [
    {
      "path": ".."
    }
  ]
}