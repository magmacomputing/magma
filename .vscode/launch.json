{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug Current Vitest File",
			"program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
			"args": ["run", "${relativeFile}"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"smartStep": true,
			"skipFiles": ["<node_internals>/**", "**/node_modules/**"]
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "Tempo Interactive REPL",
			"command": "npm run repl",
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "Tempo Plugins REPL",
			"command": "npm run repl:plugins",
			"cwd": "${workspaceFolder}"
		}
	]
}
